# --- the browser lane -------------------------------------------------------
# node_modules and Playwright's own outputs are build products, not source. The
# lane's SOURCE is e2e/*.spec.js, playwright.config.js, package.json and the
# committed lockfile; everything below is regenerated by `npm ci` and a run.
node_modules/
test-results/
playwright-report/
# Assets e2e/boot.rb COPIES out of app/assets and the installed engine. Committing
# them would create a second copy of files this lane exists to prove are the ones
# that ship — and a stale one, the moment either source moves.
test/dummy/public/
