*.gem
.bundle
Gemfile.lock
pkg/
tmp/
.DS_Store

# --- the browser lane -------------------------------------------------------
# node_modules and Playwright's own outputs are build products, not source. The
# lane's SOURCE is e2e/*.spec.js, playwright.config.js, package.json and the
# committed lockfile; everything below is regenerated by `npm ci` and a run.
# No trailing slash: "node_modules/" matches only a directory, so a node_modules
# LINK slipped past it (turf-monster committed one). The bare pattern covers both.
node_modules
# A desk that links its packages writes .npmrc (script-shell = the npm script guard,
# the hub's bin/lib/desk_node_modules.rb); ignored so the desk stays clean for `git worktree remove`.
/.npmrc
test-results/
playwright-report/
# Assets e2e/boot.rb COPIES out of app/assets and the installed engine. Committing
# them would create a second copy of files this lane exists to prove are the ones
# that ship — and a stale one, the moment either source moves.
test/dummy/public/

# Agent desks. bin/agent-worktree creates <repo>/.worktrees/ in every repo it
# manages OR DISCOVERS — and it discovers this one. Untracked, the directory
# leaves the primary checkout permanently dirty from the moment a desk exists,
# which violates the clean-up SOP's "every primary checkout must end clean" and
# blocks any ship that requires one.
.worktrees/
