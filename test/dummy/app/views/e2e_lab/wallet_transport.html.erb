<%# Drives the SHIPPED redirect transport in a real browser.

    THE PAGE CARRIES NO TRANSPORT LOGIC. Every hook below delegates straight into
    window.SolanaStudio.*, which are the four files e2e/boot.rb copied out of
    app/assets — byte for byte what a consumer installs. The moment this page
    reimplements any of it, the spec grades the lab and the lane reports green
    over gem code no browser ever touched.

    WHAT THIS TIER CAN SEE AND THE NODE SUITES CANNOT. They stub window and
    localStorage and prove the algorithm. They cannot prove the files PARSE and
    EXECUTE when a browser loads them — a stray byte or a syntax error a node
    require tolerated leaves the hooks below MISSING and is invisible everywhere
    else. And they cannot stage the event the whole design exists for: a REAL
    navigation that destroys the page, with the journal expected to survive it in
    real browser storage rather than in a hash a test kept alive. %>
<%# NACL IS LOADED HERE, NOT IN THE LAYOUT, and the reason is a spec this once
    broke. e2e/phantom_deeplink.spec.js installs a STUB nacl through
    page.addInitScript so it can assert a byte-exact payload from fixed keys. An
    init script runs BEFORE the document's own tags, so a blocking nacl tag in
    the shared layout loads after it and CLOBBERS the stub — the deep link then
    keys a real random session and the byte-exact assertion fails with 32 random
    bytes where 32 sevens were expected. Scoped to this page, the two lanes do
    not collide: that spec keeps its stub, and this one gets real crypto. %>
<script src="/e2e/js/nacl-fast.min.js"></script>

<main data-test="wallet-transport-lab">
  <p data-test="modules-loaded"><%= "" %></p>
  <p data-test="journal-after-return"><%= "" %></p>
  <a data-test="leave" href="/lab/guard">leave</a>
</main>

<script>
  // Presence, not behaviour: proves all four shipped files executed. Each is
  // named so a failure says WHICH one did not arrive rather than "MISSING".
  (function () {
    var S = window.SolanaStudio || {};
    var missing = ['walletTransport', 'redirectProvider', 'walletJournal', 'walletOps']
      .filter(function (k) { return !S[k]; });
    document.querySelector('[data-test="modules-loaded"]').textContent =
      missing.length ? 'MISSING: ' + missing.join(',') : 'loaded';
  })();

  // Reports whatever survived the navigation, read back through the SHIPPED
  // journal rather than by touching localStorage directly — the contract under
  // test is that the journal can read what it wrote across a page death, not
  // that a browser has storage.
  (function () {
    var pending = window.SolanaStudio.walletJournal.peek();
    document.querySelector('[data-test="journal-after-return"]').textContent =
      pending ? pending.wallet + ':' + pending.step : 'none';
  })();

  // The spec's entry points. Each returns exactly what the gem returns.
  window.labBeginConnect = function (wallet) {
    var provider = window.SolanaStudio.redirectProvider.forWallet(wallet);
    var begun = provider.beginConnect({
      appUrl: window.location.origin,
      redirectLink: window.location.origin + '/lab/wallet_transport',
      cluster: document.body.dataset.solanaCluster
    });
    // Persist through the shipped journal, exactly as walletOps would.
    window.SolanaStudio.walletJournal.save(begun.journal);
    return begun.url;
  };

  // A STAND-IN WALLET, in the browser, driving the hop the phone found broken.
  //
  // The page dies between hops in production. Here we cannot leave the document,
  // so this reproduces the ONE property that matters and that node could not see:
  // the second hop is built by a resume() that has NO CALLER — it runs where the
  // wallet sent us — so everything it needs must already be in the journal, read
  // back out of real browser storage.
  //
  // It answers the connect hop the way a wallet does (deriving the shared secret
  // from the dapp key the URL carried) and returns the SECOND hop's URL for the
  // spec to inspect. Shaped from the vendor protocol, not from our code.
  window.labSecondHopUrl = async function (wallet) {
    var S = window.SolanaStudio;
    var urls = [];
    var provider = S.redirectProvider.forWallet(wallet);
    var redirectLink = window.location.origin + '/lab/wallet_transport';

    S.walletOps.define('lab_probe', {
      prepare: function () { return Promise.resolve({ transaction: 'TXB58' }); },
      complete: function () { return Promise.resolve('done'); }
    });

    await S.walletOps.run('lab_probe', {}, {
      provider: provider, appUrl: window.location.origin,
      redirectLink: redirectLink, cluster: document.body.dataset.solanaCluster,
      navigate: function (u) { urls.push(u); }
    });

    var pair = nacl.box.keyPair();
    var dappPub = new URL(urls[0]).searchParams.get('dapp_encryption_public_key');
    var shared = nacl.box.before(S.walletTransport.base58.decode(dappPub), pair.secretKey);
    var n = nacl.randomBytes(24);
    var body = new TextEncoder().encode(JSON.stringify({ public_key: 'PK', session: 'SESS' }));
    var key = S.walletTransport.base58.encode(pair.publicKey);

    // resume() is called with NO redirectLink, exactly as the real callback page
    // calls it. If the journal did not carry the return address, hop two is built
    // without one — which is what sent a real user to Phantom's home screen.
    await S.walletOps.resume({
      phantom_encryption_public_key: key,
      solflare_encryption_public_key: key,
      wallet_encryption_public_key: key,
      nonce: S.walletTransport.base58.encode(n),
      data: S.walletTransport.base58.encode(nacl.box.after(body, n, shared))
    }, { navigate: function (u) { urls.push(u); } });

    return urls[1] || null;
  };

  window.labClearJournal = function () {
    window.SolanaStudio.walletJournal.clear();
  };

  // WHICH SIGNING DEEPLINK THE GEM CHOOSES, observed without leaving the page.
  //
  // The choice happens inside walletOps.run -> beginSigning -> signingHop, all
  // of it gem code; this hook supplies the two things a caller owns — the
  // journal fields a completed connect would have produced, and somewhere to
  // put the URL instead of window.location. Capturing `navigate` is what keeps
  // the document alive long enough for a spec to read the answer, and it is the
  // same seam the node suites use, so nothing here is a browser-only path.
  //
  // `declaration` is passed through verbatim rather than defaulted, so a spec
  // can drive BOTH branches: null leaves signOnly absent entirely.
  // THE INLINE TRANSPORT, END TO END, IN A REAL BROWSER.
  //
  // The node suite owns the branches; what only this tier can answer is whether
  // the shipped bytes RUN one — the inline path is a promise chain over a
  // provider object, and a loader difference or a stray byte leaves it throwing
  // where a node `require` tolerated it.
  //
  // THE ACCOUNT IS A REAL OBJECT HERE, not the plain string the node suite
  // passes. A `solanaWeb3.PublicKey` is an object whose toString() is its base58
  // address, and the gem reads it with `String(pk)` precisely so it can do that
  // without touching web3.js. This is the tier where that object actually
  // exists, so this is where the reduction is worth asserting.
  //
  // THE ADAPTER MODELS A REAL ONE and refuses to be lenient: signTransaction
  // THROWS on anything that is not an object, exactly as an extension does, so a
  // regression that handed it base58 fails here rather than passing quietly.
  window.labInlineRun = function (mode) {
    var S = window.SolanaStudio;
    S.walletOps.reset();

    var LINKED = 'GkxHc1Bv7pQm4RtyVn2ZcAeD8sWfLuJp3NoXaTgYkQrM';
    var STRANGER = '9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM';
    var calls = [];

    S.walletOps.define('lab_inline', {
      prepare: function (ctx) { calls.push('prepare'); return { transaction: 'TXB58', slug: 'ptx-' + ctx.id }; },
      complete: function (ctx, result, state) {
        return {
          signedType: typeof result.signedTransaction,
          signed: result.signedTransaction,
          stateTx: state.transaction,
          slug: state.slug,
          sent: result.sendStrategy,
          calls: calls
        };
      }
    });

    // A PublicKey-shaped account: an object that stringifies to its address.
    function pubkey(address) {
      return { toBase58: function () { return address; }, toString: function () { return address; } };
    }

    var provider = {
      transport: 'inline',
      connect: function () {
        calls.push('connect');
        return Promise.resolve({ publicKey: pubkey(mode === 'wrongAccount' ? STRANGER : LINKED) });
      },
      deserializeTransaction: function (wire) {
        if (typeof wire !== 'string') throw new Error('the adapter was handed a non-string to deserialize');
        calls.push('deserialize');
        return { tx: wire };
      },
      signTransaction: function (tx) {
        if (!tx || typeof tx !== 'object') throw new Error('an injected wallet signs an OBJECT, got ' + typeof tx);
        calls.push('sign');
        return Promise.resolve({ tx: 'SIGNED-' + tx.tx });
      },
      serializeTransaction: function (signed) { calls.push('serialize'); return signed.tx; }
    };
    if (mode === 'noCodec') { delete provider.deserializeTransaction; }

    return S.walletOps.run('lab_inline', { id: 7 }, {
      provider: provider,
      expectedAccount: LINKED
    }).then(function (value) {
      return { outcome: 'ran', value: value };
    }, function (e) {
      return {
        outcome: 'refused', message: e.message, calls: calls,
        wrongAccount: !!e.wrongAccount, expected: e.expected || null, connected: e.connected || null
      };
    });
  };

  window.labSigningHop = function (wallet, declaration) {
    var S = window.SolanaStudio;
    S.walletOps.reset();

    var handler = {
      prepare: function () { return { transaction: 'TXB58' }; },
      complete: function () { return 'done'; }
    };
    if (declaration !== null) { handler.signOnly = declaration; }
    S.walletOps.define('lab_intent', handler);

    var b58 = S.walletTransport.base58;
    var dapp = window.nacl.box.keyPair();
    var wal = window.nacl.box.keyPair();
    var chosen = null;

    return S.walletOps.run('lab_intent', {}, {
      provider: S.redirectProvider.forWallet(wallet),
      redirectLink: window.location.origin + '/lab/wallet_transport',
      navigate: function (url) { chosen = url; },
      session: {
        dappSecretKey: b58.encode(dapp.secretKey),
        dappPublicKey: b58.encode(dapp.publicKey),
        walletPublicKey: b58.encode(wal.publicKey),
        session: 'LAB'
      }
    }).then(function () { return chosen; });
  };
</script>
